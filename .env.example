# Required to install private @sektant1 packages from GitHub Packages.
GITHUB_PACKAGES_TOKEN=

# Optional. GitHub Actions deploys from commits; this is only useful when a
# Vercel Deploy Hook exists for the project.
VERCEL_DEPLOY_HOOK_URL=
