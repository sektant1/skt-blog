ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
LOCAL_ADMIN_ONLY=true
ADMIN_REGISTRATION_ENABLED=false
SITE_URL=http://localhost:3000

# local | github
CONTENT_BACKEND=local

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
