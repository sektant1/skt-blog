{
  "name": "sektants-hideout",
  "version": "0.1.0",
  "private": true,
  "description": "sektant's hideout - personal technical archive",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run content:check && npm run search:index && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "phosphor:css": "node scripts/extract-phosphor-css.mjs",
    "content:check": "tsx scripts/check-content.ts",
    "search:index": "tsx scripts/generate-search-index.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.7",
    "@sektant1/phosphor-ui": "^0.3.22",
    "@types/mdx": "^2.0.13",
    "bcryptjs": "^3.0.3",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.1.3",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.94.2",
    "tsx": "^4.21.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "typescript": "^5.9.3"
  }
